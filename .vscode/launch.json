{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Run app",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": [
        "run",
        "--no-debugger",
        "--no-reload"
      ],
      "env": {
        "FLASK_APP": "${workspaceFolder}/app.py",
        "FLASK_DEBUG": "1"
      },
      "jinja": true
    }
  ]
}
