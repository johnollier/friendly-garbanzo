{
  "name": "friendly-garbanzo",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/friendly-garbanzo",
  "forwardPorts": [5000, 5432],
  "portsAttributes": {
    "5000": {
      "label": "Flask app"
    },
    "5432": {
      "label": "PostgreSQL"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "shutdownAction": "stopCompose"
}
